{
  "name": "poetry-realm-web-system",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "client:dev": "vite",
    "server:dev": "node --watch server.js",
    "build": "tsc && vite build",
    "serve": "NODE_ENV=production node server.js",
    "poem:generate": "node scripts/generate-poem.js"
  },
  "dependencies": {
    "@fontsource/lxgw-wenkai": "^5.3.0",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "lucide-react": "^0.400.0",
    "opencc-js": "^1.0.5",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.24.0",
    "three": "^0.160.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.160.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.4.0",
    "vite": "^5.3.0"
  }
}
