# 诗境 Poetry Realm · 环境变量模板
# 复制为 web-system/.env 后填写真实值：cp .env.example .env
#（服务端会自动读取本目录 .env；密钥请勿提交仓库）

# ── 服务 ──
# 监听端口（默认 3300，nginx/域名场景内部端口即可）
PORT=3300

# ── 数据库/产物（默认 web-system/data/ 下，一般无需改）──
# POETRY_DB=./data/poetry.db

# ── 本地访问统计 Umami 转发目标（可选；default http://localhost:8765）──
# UMAMI_URL=http://localhost:8765

# ── 火山方舟 Ark · AI 视频生成 ──
# 必填：火山方舟 API Key
ARK_API_KEY=
# 图片公网基址（视频生成要求图片可被火山侧公网拉取；资源站就绪后填写，勿留 http://localhost）
# PUBLIC_ASSET_BASE=https://assets.example.com
# 模型名（默认 seedance-mini；如需改用接入点填 ark-xxxx）
# ARK_MODEL=doubao-seedance-2-0-mini-260615

# ── 腾讯云语音（tencent 引擎配音时使用；edge 引擎无需）──
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_TTS_REGION=ap-beijing
TENCENT_TTS_VOICE_DEFAULT=
